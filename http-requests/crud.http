### 1. GET all flowers
GET http://localhost:8080/api/v1/flowers
Accept: application/json

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### 2. CREATE flower
POST http://localhost:8080/api/v1/flowers
Content-Type: application/json

{
  "name": "Blue Hydrangea",
  "category": "HYDRANGEA",
  "price": 5.5,
  "stock": 40,
  "description": "Big blue hydrangea bush"
}

> {%
    client.test("Status is 201", function () {
        client.assert(response.status === 201, "Expected 201");
    });
    client.global.set("flowerId", response.body.id);
%}

### 3. GET one flower
GET http://localhost:8080/api/v1/flowers/{{flowerId}}
Accept: application/json

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### 4. UPDATE flower
PUT http://localhost:8080/api/v1/flowers/{{flowerId}}
Content-Type: application/json

{
  "name": "Blue Hydrangea",
  "category": "HYDRANGEA",
  "price": 6.9,
  "stock": 35,
  "description": "Big blue hydrangea bush, updated price"
}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### 5. DELETE flower
DELETE http://localhost:8080/api/v1/flowers/{{flowerId}}

> {%
    client.test("Status is 204", function () {
        client.assert(response.status === 204, "Expected 204");
    });
%}

### 6. GET deleted flower (should be 404)
GET http://localhost:8080/api/v1/flowers/{{flowerId}}
Accept: application/json

> {%
    client.test("Status is 404", function () {
        client.assert(response.status === 404, "Expected 404");
    });
%}