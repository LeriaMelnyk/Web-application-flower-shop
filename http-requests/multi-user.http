### 2. USER tries to create flower -> 403
POST http://localhost:8080/api/v1/flowers
Authorization: Basic user user
Content-Type: application/json

{
  "name": "Pink Carnation",
  "category": "CARNATION",
  "price": 1.5,
  "stock": 100,
  "description": "Pink carnation"
}

> {%
    client.test("2. USER creates -> 403", function () {
        client.assert(response.status === 403, "Expected 403");
    });
%}

