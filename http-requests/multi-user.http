### 5. ADMIN creates flower -> 201
POST http://localhost:8080/api/v1/flowers
Authorization: Basic admin admin
Content-Type: application/json

{
  "name": "Pink Carnation",
  "category": "CARNATION",
  "price": 1.5,
  "stock": 100,
  "description": "Pink carnation"
}

> {%
    client.test("5. ADMIN creates -> 201", function () {
        client.assert(response.status === 201, "Expected 201");
    });
    client.global.set("newId", response.body.id);
%}

###

### 6. ADMIN updates flower -> 200
PUT http://localhost:8080/api/v1/flowers/{{newId}}
Authorization: Basic admin admin
Content-Type: application/json

{
  "name": "Pink Carnation",
  "category": "CARNATION",
  "price": 1.9,
  "stock": 90,
  "description": "Pink carnation, new price"
}

> {%
    client.test("6. ADMIN updates -> 200", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}

