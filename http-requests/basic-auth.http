###

### 6. CREATE flower as admin -> 201
POST http://localhost:8080/api/v1/flowers
Authorization: Basic admin admin
Content-Type: application/json

{
  "name": "Blue Hydrangea",
  "category": "HYDRANGEA",
  "price": 5.5,
  "stock": 40,
  "description": "Big blue hydrangea bush"
}

> {%
    client.test("6. Admin creates -> 201", function () {
        client.assert(response.status === 201, "Expected 201");
    });
    client.global.set("flowerId", response.body.id);
%}

###

### 7. GET one flower as user -> 200
GET http://localhost:8080/api/v1/flowers/{{flowerId}}
Authorization: Basic user user
Accept: application/json

> {%
    client.test("7. User reads one -> 200", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}

###

### 8. UPDATE flower as superadmin -> 200
PUT http://localhost:8080/api/v1/flowers/{{flowerId}}
Authorization: Basic superadmin superadmin
Content-Type: application/json

{
  "name": "Blue Hydrangea",
  "category": "HYDRANGEA",
  "price": 6.9,
  "stock": 35,
  "description": "Updated price"
}

> {%
    client.test("8. Superadmin updates -> 200", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}

###

### 9. DELETE flower as admin -> 204
DELETE http://localhost:8080/api/v1/flowers/{{flowerId}}
Authorization: Basic admin admin

> {%
    client.test("9. Admin deletes -> 204", function () {
        client.assert(response.status === 204, "Expected 204");
    });
%}

