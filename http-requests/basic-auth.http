### 1. GET all flowers WITHOUT auth -> 401
GET http://localhost:8080/api/v1/flowers
Accept: application/json

> {%
    client.test("1. No auth -> 401", function () {
        client.assert(response.status === 401, "Expected 401");
    });
%}

###

### 2. GET all flowers as admin -> 200
GET http://localhost:8080/api/v1/flowers
Authorization: Basic admin admin
Accept: application/json

> {%
    client.test("2. Admin reads all -> 200", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}

###

### 3. GET all flowers with WRONG password -> 401
GET http://localhost:8080/api/v1/flowers
Authorization: Basic admin wrongpass
Accept: application/json

> {%
    client.test("3. Wrong password -> 401", function () {
        client.assert(response.status === 401, "Expected 401");
    });
%}

###

### 4. GET hello as user -> 200
GET http://localhost:8080/api/v1/flowers/hello
Authorization: Basic user user

> {%
    client.test("4. User hello -> 200", function () {
        client.assert(response.status === 200, "Expected 200");
    });
%}

###

### 5. GET hello WITHOUT auth -> 401
GET http://localhost:8080/api/v1/flowers/hello

> {%
    client.test("5. Hello no auth -> 401", function () {
        client.assert(response.status === 401, "Expected 401");
    });
